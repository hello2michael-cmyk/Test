{
  "name": "TV Mirror",
  "short_name": "TV Mirror",
  "description": "Play a video on your phone and watch the same thing on your TCL TV.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
