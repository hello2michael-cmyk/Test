      "props": [{ "type": "stain", "pos": [0.4, -1.2], "size": 0.7 }, { "type": "stain", "pos": [1.9, -2.4], "size": 0.5 }, { "type": "stain", "pos": [-0.8, -2.6], "size": 0.35 },
                { "type": "table", "pos": [1.2, -2.6], "yaw": 0, "color": "#3b2718" }, { "type": "book", "pos": [1.2, -2.6], "y": 0.75, "open": true }, { "type": "candle", "pos": [0.5, -2.6], "y": 0.75 },
                { "type": "axe", "pos": [-2.4, -3.0], "yaw": 30 }, { "type": "text", "pos": [1.2, -2.6], "y": 1.6, "text": "Dear devil,", "color": "#1a0a0a", "textColor": "#ff8a8a" }]
