      "props": [{ "type": "door", "pos": [3.6, -3.98], "color": "#4a2e17" }]
    },
    {
      "narration": "She showed him the guest room. There was one rule. Do not be awake after midnight. Or else.",
      "emphasis": ["rule", "midnight", "else"],
