      ],
      "props": [{ "type": "candle", "pos": [-0.5, -3.4], "y": 0.6 }]
    },
    {
      "narration": "But every day, the granny got meaner. She snapped at him. She pinched him. She hit him.",
      "emphasis": ["meaner", "hit"],
      "set": "home", "time": "day",
      "camera": { "azimuth": -0.2, "distance": 5.4, "target": [0, 0.9, -1.6], "move": "push" },
