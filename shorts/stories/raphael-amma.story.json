      "camera": { "azimuth": -0.25, "distance": 6.0, "target": [0.2, 0.9, -1.8], "move": "push" },
      "vignette": true,
      "actors": [
        { "who": "granny", "pos": [1.6, -1.4], "yaw": -60, "action": "point", "face": "neutral", "keys": [{ "at": 2.0, "say": "Not after midnight." }, { "at": 4.2, "say": "Or else.", "face": "evil" }] },
        { "who": "jack", "pos": [-0.8, -0.8], "yaw": 50, "action": "idle", "face": "neutral", "keys": [{ "at": 4.2, "face": "scared" }] }
      ]
    },
    {
      "narration": "The first nights, Jack could not sleep. Just homesick, he told himself. Just homesick.",
      "emphasis": ["sleep", "homesick"],
      "set": "bedroom", "time": "night",
      "camera": { "azimuth": -0.35, "elevation": 0.45, "distance": 5.0, "target": [-2.2, 0.6, -2.2], "move": "orbit" },
