        { "who": "jack", "pos": [-3.2, -2.5], "yaw": 20, "action": "sit", "face": "neutral", "keys": [{ "at": 1.4, "hold": "cup" }] }
      ],
      "props": [{ "type": "door", "pos": [3.6, -3.98], "color": "#4a2e17" }]
    },
    {
      "narration": "Hours passed. On the shelf, Jack found a photo. The granny, standing next to another home nurse.",
      "emphasis": ["photo", "another"],
      "set": "home", "time": "sunset",
      "camera": { "azimuth": -0.05, "distance": 4.6, "target": [0.4, 1.1, -2.8], "move": "push" },
      "actors": [
        { "who": "jack", "pos": [0.4, -2.2], "yaw": 180, "action": "idle", "face": "neutral", "keys": [{ "at": 2.0, "action": "hold", "hold": "photo", "yaw": 0, "face": "surprised" }] }
      ],
      "props": [{ "type": "photo", "pos": [0.4, -3.6], "y": 0.86, "yaw": 0 }, { "type": "door", "pos": [3.6, -3.98], "color": "#4a2e17" }]
    },
    {
      "narration": "That one left early, she said. Jack was not so sure about that.",
      "emphasis": ["early", "sure"],
      "set": "home", "time": "sunset",
      "camera": { "azimuth": -0.3, "distance": 5.2, "target": [0.6, 0.9, -2.0] },
      "vignette": true,
      "actors": [
        { "who": "jack", "pos": [-0.4, -1.6], "yaw": 90, "action": "hold", "face": "neutral", "look": { "hold": "photo" }, "keys": [{ "at": 2.0, "face": "sad", "action": "think", "hold": null }] },
