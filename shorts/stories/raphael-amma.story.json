  "scenes": [
    {
      "narration": "Jack was a home nurse. One morning his manager sent him to a new patient. An extraordinary old woman, he called her.",
      "emphasis": ["nurse", "extraordinary"],
      "set": "street", "time": "day",
      "camera": { "distance": 5.8, "move": "push" },
      "actors": [
        { "who": "jack", "pos": [-0.9, 0.5], "yaw": 60, "action": "idle", "face": "neutral" },
        { "who": "manager", "pos": [1.1, 0.4], "yaw": -70, "action": "talk", "face": "happy", "keys": [{ "at": 2.2, "action": "point", "yaw": 150 }] }
      ],
      "props": [{ "type": "car", "pos": [4.6, -1.5], "color": "#8e8e8e" }]
    },
    {
      "narration": "Jack asked if it was really okay. Of course it's okay, said the manager. You will get paid a lot. Go in.",
      "emphasis": ["okay", "lot"],
