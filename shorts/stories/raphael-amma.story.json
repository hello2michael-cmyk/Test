        { "who": "kid3", "pos": [1.8, -2.1], "yaw": 180, "action": "scared", "face": "scared", "keys": [{ "at": 2.2, "action": "run", "to": [1.8, -7], "dur": 1.2 }] },
        { "who": "kid4", "pos": [2.6, -2.3], "yaw": 180, "action": "scared", "face": "scared", "keys": [{ "at": 2.8, "action": "run", "to": [2.6, -7], "dur": 1.2 }] },
        { "who": "kid5", "pos": [0.6, -1.0], "yaw": 160, "action": "idle", "face": "scared" }, { "who": "kid6", "pos": [1.6, -0.9], "yaw": 200, "action": "idle", "face": "scared" },
