        { "who": "jack", "pos": [-1.0, -1.6], "yaw": 90, "action": "idle", "face": "sad", "keys": [{ "at": 3.4, "action": "scared", "face": "scared" }] }
      ],
      "props": [{ "type": "door", "pos": [3.6, -3.98], "color": "#4a2e17" }]
    },
    {
      "narration": "One night he was still awake after midnight. And then he heard it. Knocking. Slow. Odd. Knocking.",
      "emphasis": ["awake", "Knocking"],
