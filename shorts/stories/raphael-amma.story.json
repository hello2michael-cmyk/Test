        { "who": "appa", "pos": [-3.2, -2.5], "yaw": 0, "action": "sit", "face": "neutral", "look": { "hold": "phone" } },
        { "who": "kid1", "pos": [0.2, -2.2], "yaw": 180, "action": "idle" }, { "who": "kid2", "pos": [1.0, -2.3], "yaw": 180, "action": "idle" },
        { "who": "kid3", "pos": [1.8, -2.1], "yaw": 180, "action": "idle" }, { "who": "kid4", "pos": [2.6, -2.3], "yaw": 180, "action": "idle" },
