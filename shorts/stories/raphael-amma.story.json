        { "who": "manager", "pos": [1.1, 0.4], "yaw": -70, "action": "talk", "face": "happy", "keys": [{ "at": 2.2, "say": "You'll get paid a LOT." }, { "at": 4.2, "action": "point", "yaw": 150, "say": "Go in." }] }
      ]
    },
    {
      "narration": "The granny welcomed him with a cup of chai. Sit on the sofa and wait, she said. I have to go to my room.",
