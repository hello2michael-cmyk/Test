        { "who": "granny", "pos": [-1.2, -0.6], "yaw": 120, "action": "possessed", "face": "evil" },
        { "who": "appa", "pos": [-3.2, -2.5], "yaw": 0, "action": "sit", "face": "scared", "keys": [{ "at": 0.5, "action": "run", "to": [-3.4, -7], "dur": 1.4 }] },
        { "who": "kid1", "pos": [0.2, -2.2], "yaw": 180, "action": "scared", "face": "scared", "keys": [{ "at": 1.0, "action": "run", "to": [0.2, -7], "dur": 1.2 }] },
