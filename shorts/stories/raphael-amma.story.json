      "set": "cabin", "time": "night",
      "camera": { "azimuth": -0.15, "distance": 5.2, "target": [0, 1.0, -1.6], "move": "push" },
      "tint": "#8a0f1a", "tintAlpha": 0.22, "vignette": true,
      "actors": [
        { "who": "granny", "pos": [0, -1.6], "yaw": 0, "action": "pray", "face": "blank", "keys": [{ "at": 2.4, "face": "evil", "say": "Let me eat them all." }] }
