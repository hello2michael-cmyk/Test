      ]
    },
    {
      "narration": "Inside: blood on the floor. And a book, full of odd letters. The first words read: Dear devil.",
      "emphasis": ["blood", "Dear", "devil"],
      "set": "cabin", "time": "night",
      "camera": { "azimuth": -0.2, "elevation": 0.5, "distance": 5.2, "target": [0.2, 0.5, -1.6], "move": "push" },
      "tint": "#5a0a12", "tintAlpha": 0.1, "vignette": true,
      "actors": [
