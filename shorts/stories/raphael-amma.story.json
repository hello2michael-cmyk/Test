      "props": [{ "type": "candle", "pos": [-0.5, -3.4], "y": 0.6 }, { "type": "text", "pos": [1.8, -3.6], "y": 2.6, "text": "KNOCK. KNOCK.", "color": "#000000" }]
    },
    {
      "narration": "He fell asleep right there. In the morning he told himself it was just a bad dream. Just a nightmare.",
      "emphasis": ["dream", "nightmare"],
      "set": "bedroom", "time": "day",
      "camera": { "azimuth": -0.35, "elevation": 0.4, "distance": 5.2, "target": [-2.2, 0.6, -2.2], "move": "pull" },
      "actors": [
        { "who": "jack", "pos": [-2.4, -1.9], "y": 0.66, "yaw": 0, "action": "lie", "face": "neutral", "keys": [{ "at": 2.6, "action": "sit", "y": 0, "pos": [-1.6, -1.0], "yaw": 40, "face": "sad" }] }
      ]
    },
    {
      "narration": "The next night, she came into his room. And she told him a story. Not about herself, she said. About Raphael Amma.",
